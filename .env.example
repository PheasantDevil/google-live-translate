# Google AI (Gemini Live API)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ephemeral token signing (server-side only — never expose to client in production)
# Used by /api/live-token route to mint short-lived client tokens
GEMINI_API_KEY_SERVER=

# Optional: lock target language server-side (BCP-47, e.g. "ja", "en")
# Leave empty to allow client-side language selection
DEFAULT_TARGET_LANGUAGE=ja
